# サイト公開 URL（canonical・OGP・sitemap の絶対 URL 生成に使用。末尾スラッシュなし）
# 未設定時は https://bug-fix.org/siid が使われる（src/constants/meta.ts）
NEXT_PUBLIC_SITE_URL=https://bug-fix.org/siid

# 計測タグ（アナリティクス）用の環境変数
# 現行サイト（bug-fix.org/siid）から引き継いだ計測タグの ID を設定する（Issue #19）。
# ローカル開発では .env.local にコピーして値を設定し、本番は Vercel の
# Environment Variables に同名で登録する。NEXT_PUBLIC_ 接頭辞はクライアントへ露出する。

# Google Analytics 4（gtag.js）の測定 ID
NEXT_PUBLIC_GA_ID=G-54L1JQ7Q7V

# Google Tag Manager のコンテナ ID（カンマ区切りで複数指定可）
NEXT_PUBLIC_GTM_IDS=GTM-58D75LLL,GTM-PCDDS7MV,GTM-NWT5NTNS

# UserHeat（ヒートマップ）のサイト ID
NEXT_PUBLIC_USERHEAT_ID=uhR7AfnJKz

# KARTE のプロジェクト ID
NEXT_PUBLIC_KARTE_ID=81f5dc95580fe42385d93c4da40b387e

# OpenAI Ads ピクセル ID
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID=DNSeeLpdRTGGyfec5wUced

# microCMS（SiiD BLOG）連携 — TOPページ News セクションで使用
# 値は microCMS 管理画面から取得し、.env.local と Vercel の環境変数に設定してください。
# いずれもサーバー専用（NEXT_PUBLIC_ を付けない＝クライアントに露出しない）。

# `https://XXXX.microcms.io` の XXXX 部分
MICROCMS_SERVICE_DOMAIN=

# 読み取り（GET）用 API キー
MICROCMS_API_KEY=
